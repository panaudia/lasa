{
  "name": "@panaudia/lasa-client",
  "version": "0.2.0",
  "description": "LASA TypeScript client SDK: live spatial audio over Media-over-QUIC (WebTransport, WebCodecs, AudioWorklet)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panaudia/lasa.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/panaudia/lasa/tree/main/typescript",
  "keywords": [
    "spatial-audio",
    "ambisonics",
    "binaural",
    "webtransport",
    "media-over-quic",
    "moq",
    "webcodecs",
    "opus"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:interop": "playwright test",
    "prepublishOnly": "npm run build && npm test",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.1.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
